{
  "name": "tw-environment-watch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.js --outDir dist-ssr && node scripts/prerender.js",
    "build:client": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fetch:air-quality": "node --env-file=.env scripts/fetch-air-quality.js",
    "fetch:earthquake": "node --env-file=.env scripts/fetch-earthquake.js"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
